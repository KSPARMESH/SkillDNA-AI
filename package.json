{
  "name": "skilldna-ai",
  "version": "1.0.0",
  "description": "SkillDNA AI - Your Living Technical Identity (Enterprise AI-Powered SaaS Monorepo)",
  "private": true,
  "license": "MIT",
  "author": "Parmesh KS",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "skilldna",
    "ai",
    "technical-identity",
    "monorepo",
    "turborepo",
    "pnpm",
    "nextjs",
    "express",
    "prisma",
    "gemini-ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/parmeshks/SkillDNA-AI.git"
  },
  "bugs": {
    "url": "https://github.com/parmeshks/SkillDNA-AI/issues"
  },
  "homepage": "https://github.com/parmeshks/SkillDNA-AI#readme",
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:worker": "turbo run dev --filter=worker",
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=frontend",
    "build:backend": "turbo run build --filter=backend",
    "build:worker": "turbo run build --filter=worker",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "clean:modules": "rimraf node_modules **/node_modules",
    "db:generate": "turbo run db:generate --filter=database",
    "db:migrate": "turbo run db:migrate --filter=database",
    "db:seed": "turbo run db:seed --filter=database",
    "db:studio": "pnpm --filter database studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "audit": "pnpm audit",
    "prepare": "husky",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
