# ==============================================================================
# SkillDNA AI - Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' in local development. Never commit '.env'!

# ------------------------------------------------------------------------------
# 1. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="SkillDNA AI"
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
SERVER_PORT=5000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=skilldna_db
DATABASE_USER=skilldna_user
DATABASE_PASSWORD=skilldna_secure_password
DATABASE_URL="postgresql://skilldna_user:skilldna_secure_password@localhost:5432/skilldna_db?schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Caching, Rate Limiting & BullMQ Queues)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT & OAuth)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_access_token_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your_super_secret_session_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------------------------------------------
# 5. CLOUDINARY FILE STORAGE (Resumes, Avatars, Certifications)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. GEMINI AI ENGINE
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 7. EMAIL SERVICE (SMTP Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="SkillDNA AI <noreply@skilldna.ai>"

# ------------------------------------------------------------------------------
# 8. SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 9. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIRECTORY=logs

# ------------------------------------------------------------------------------
# 10. MONITORING & ERROR TRACKING
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 11. FUTURE PLATFORM INTEGRATIONS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_optional
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_oauth_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_oauth_client_secret
LEETCODE_API_URL=https://leetcode.com/graphql
HACKERRANK_API_URL=https://www.hackerrank.com/rest/hackers
